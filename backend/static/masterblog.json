{
  "swagger": "2.0",
  "info": {
    "title": "Masterblog API",
    "version": "1.0.0"
  },
  "host": "localhost:5002",
  "tags": [{"name": "Post", "description": "Post API - CRUD"}],
  "paths": {
    "/api/posts": {
      "get": {
        "summary": "Returns all posts",
        "tags": ["Post"],
        "produces": ["application/json"],
        "parameters": [
          {"name": "sort", "in": "query", "type": "string", "enum": ["title", "content"], "required": false},
          {"name": "direction", "in": "query", "type": "string", "enum": ["asc", "desc"], "required": false}
        ],
        "responses": {
          "200": {"description": "Successful operation"},
          "400": {"description": "Invalid sort field or direction"}
        }
      },
      "post": {
        "summary": "Adds a new post",
        "tags": ["Post"],
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {"name": "body", "in": "body", "required": true, "schema": {"$ref": "#/definitions/NewPost"}}
        ],
        "responses": {
          "201": {"description": "Post created"},
          "400": {"description": "Missing title or content"}
        }
      }
    },
    "/api/posts/{id}": {
      "put": {
        "summary": "Updates a post",
        "tags": ["Post"],
        "consumes": ["application/json"],
        "produces": ["application/json"],
        "parameters": [
          {"name": "id", "in": "path", "type": "integer", "required": true},
          {"name": "body", "in": "body", "required": true, "schema": {"$ref": "#/definitions/NewPost"}}
        ],
        "responses": {
          "200": {"description": "Post updated"},
          "404": {"description": "Post not found"}
        }
      },
      "delete": {
        "summary": "Deletes a post",
        "tags": ["Post"],
        "produces": ["application/json"],
        "parameters": [
          {"name": "id", "in": "path", "type": "integer", "required": true}
        ],
        "responses": {
          "200": {"description": "Post deleted"},
          "404": {"description": "Post not found"}
        }
      }
    },
    "/api/posts/search": {
      "get": {
        "summary": "Searches posts by title and/or content",
        "tags": ["Post"],
        "produces": ["application/json"],
        "parameters": [
          {"name": "title", "in": "query", "type": "string", "required": false},
          {"name": "content", "in": "query", "type": "string", "required": false}
        ],
        "responses": {
          "200": {"description": "Matching posts"}
        }
      }
    }
  },
  "definitions": {
    "NewPost": {
      "type": "object",
      "properties": {
        "title": {"type": "string"},
        "content": {"type": "string"}
      }
    }
  }
}
